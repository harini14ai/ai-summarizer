# ============================================
# Server Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ── App ──────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── MongoDB ──────────────────────────────────
# Local:  mongodb://localhost:27017/ai-summarizer
# Atlas:  mongodb+srv://user:pass@cluster.mongodb.net/ai-summarizer?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/ai-summarizer

# ── JWT ──────────────────────────────────────
# Use a long random string in production: openssl rand -hex 64
JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_EXPIRE=7d

# ── CORS ─────────────────────────────────────
# Local dev
CLIENT_URL=http://localhost:5173
# Production (comma-separated for multiple origins)
# CLIENT_URL=https://your-app.vercel.app,https://your-app.netlify.app
FRONTEND_URL=

# ── AI API Keys ───────────────────────────────
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key

# Gemini: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-key

# Claude: https://console.anthropic.com/
CLAUDE_API_KEY=sk-ant-your-claude-key

# ── Demo Mode ─────────────────────────────────
# Set to true to use mock AI (no API credits needed)
# Set to false when you have valid API keys with billing
DEMO_MODE=true

# ── File Upload ───────────────────────────────
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=pdf,docx,txt

# ── Rate Limiting ─────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── Logging ───────────────────────────────────
LOG_LEVEL=info
